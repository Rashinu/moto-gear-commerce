# Copy this file to .env (or set these as environment variables on your host) to enable
# permanent, free persistence. If left unset, the app falls back to a local JSON file
# and local disk storage (fine for local testing, but not persistent on free hosts).

# Postgres connection string from a free provider like Neon.tech (neon.tech).
# Example: postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Cloudinary credentials (free tier) from your Cloudinary dashboard (cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
